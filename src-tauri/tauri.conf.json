{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nodemind",
  "version": "1.0.0",
  "identifier": "com.nokast.nodemind",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Nodemind",
        "width": 1120,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620,
        "resizable": true,
        "minimizable": true,
        "maximizable": true,
        "closable": true,
        "fullscreen": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/prompts.toml",
      "resources/models/**/*"
    ],
    "externalBin": [
      "binaries/whisper-cli",
      "binaries/llama-server"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "category": "Productivity",
    "longDescription": "A voice-first personal assistant that runs 100% on your Mac. Talk out your messy thoughts and Nodemind turns them into clean checklists, a live thought graph, and a friction-free plan for today."
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRERTFENjlDREM5MEY1NzEKUldSeDlaRGNuTmJoVGZZSlNtRTRsMzhxdk44T1E4cHlEWjZVcXBic1lYaldjNVpmTVJxMlM4L2UK",
      "endpoints": [
        "https://github.com/abhishek085/Nodemind/releases/latest/download/nodemind-updater.json"
      ]
    }
  }
}
